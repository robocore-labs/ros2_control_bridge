<?xml version="1.0"?>
<package format="3">
  <name>ros2_control_bridge</name>
  <version>0.0.1</version>
  <description>Robot-agnostic ros2_control SystemInterface that bridges controller commands to ROS topics and reads joint states back. Groups, topics and interfaces are declared in the URDF, so one build serves any robot.</description>

  <maintainer email="you@example.com">You</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
